.POSIX:
.SUFFIXES:
.SUFFIXES: .c .o .uto

VERSION    = 1.0.0

CC         = @CC@
CCOV       = gcov
CFLAGS     = @CFLAGS@
CFLAGS_COV = @CFLAGS_COV@
CFLAGS_SAN = @CFLAGS_SAN@
INCLUDEDIR = @PREFIX@/include
LD         = @LD@
LIBDIR     = @PREFIX@/lib
PREFIX     = @PREFIX@

.PHONY: all
all: libdial.a

libdial.a: dial.o
	$(LD) -r $^ -o $@

.c.o:
	$(CC) $(CFLAGS) -I. -c $< -o $@

.c.uto:
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. -c $^ -o $@

dial.coverage: dial.uto tests/test_dial.uto
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) $^ -o $@
	./$@
	$(CCOV) dial.c
	! grep "#####" dial.c.gcov |grep -ve "// UNREACHABLE$$"

libdial.pc:
	( echo 'Name: libdial' ;\
	echo 'Version: $(VERSION)' ;\
	echo 'Description: C socket library' ;\
	echo 'prefix=$(PREFIX)' ;\
	echo 'exec_prefix=$${prefix}' ;\
	echo 'includedir=$${prefix}/include' ;\
	echo 'libdir=$${prefix}/lib' ;\
	echo 'Cflags: -I$${includedir}' ;\
	echo 'Libs: -L$${libdir} -ldial' ) > $@

.PHONY: test
test: dial.coverage

.PHONY: install
install: dial.h libdial.a libdial.pc
	mkdir -p $(DESTDIR)$(INCLUDEDIR)/libdial
	mkdir -p $(DESTDIR)$(LIBDIR)/pkgconfig
	install -m644 dial.h $(DESTDIR)$(INCLUDEDIR)/libdial/dial.h
	install -m644 libdial.a $(DESTDIR)$(LIBDIR)/libdial.a
	install -m644 libdial.pc $(DESTDIR)$(LIBDIR)/pkgconfig/libdial.pc

.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(INCLUDEDIR)/libdial/dial.h
	rm -f $(DESTDIR)$(LIBDIR)/libdial.a
	rm -f $(DESTDIR)$(LIBDIR)/pkgconfig/libdial.pc

.PHONY: clean
clean:
	rm -f *.o **/*.o *.uto **/*.uto *.gc?? **/*.gc?? *.coverage
	rm -f libdial.a libdial.pc

.PHONY: distclean
distclean: clean
	rm -f Makefile config.status
